# --- Site -------------------------------------------------------------
# Canonical origin. On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Catalog source ---------------------------------------------------
# Leave everything in this section unset to use the built-in mock catalog.
# A provider must be fully set or fully unset: a half-configured one stops the build with an error
# instead of silently falling back to mock.
#
# Shopify (Storefront API). Set both to use a Shopify store. Takes precedence over SFCC.
# Token: install the Headless sales channel in the store admin, create a storefront, copy the
# private access token (server-side; starts with shpat_). A public token also works.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# Optional. Defaults to the version pinned in src/lib/commerce/shopify.ts.
SHOPIFY_API_VERSION=

# Set all four to use Salesforce Commerce Cloud via SCAPI (reference adapter, not yet validated against a live realm).
SFCC_SHORT_CODE=
SFCC_ORG_ID=
SFCC_CLIENT_ID=
SFCC_REDIRECT_URI=

# --- Incremental migration -------------------------------------------
# When set, routes marked "legacy" in migration.config.json are proxied here.
LEGACY_ORIGIN=

# --- Operations -------------------------------------------------------
# Shared secret for the catalog-publish webhook (POST /api/revalidate).
REVALIDATE_SECRET=
# Simulated catalog latency in ms, to make streaming and caching visible.
MOCK_LATENCY_MS=0
